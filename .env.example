DATABASE_URL=postgresql+asyncpg://emoda:change_me@db:5432/emoda
POSTGRES_DB=emoda
POSTGRES_USER=emoda
POSTGRES_PASSWORD=change_me

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+00000000000
TELEGRAM_SESSION_PATH=/data/session/collector
BOT_TOKEN=
BOOTSTRAP_ADMIN_IDS=123456789

# Optional. Strict parsing works without Gemini; configured Gemini-dependent items go to review.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_OCR_MODEL=gemini-3.5-flash

MEDIA_ROOT=/data/media
WORKER_POLL_SECONDS=1
# Re-read this many newest posts per source on startup to detect edits made during downtime.
CATCHUP_EDIT_RESCAN_LIMIT=500
# Delete only non-critical local media after this age, in bounded queue passes.
MEDIA_RETENTION_DAYS=30
MEDIA_RETENTION_BATCH_SIZE=25
MEDIA_RETENTION_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
HEALTH_FILE=/tmp/emoda-healthy
